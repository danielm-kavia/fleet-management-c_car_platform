# Fleet Management service base config
HOST=0.0.0.0
PORT=3010
NODE_ENV=development
LOG_LEVEL=info

# Dev storage
# - memory: reset on restart
# - file: persists to disk
STORE_MODE=file
STORE_FILE_PATH=./data/store.json

# Auth/JWT stub settings
# If AUTH_REQUIRED=false, requests run as a dev "admin" with orgId="dev-org".
AUTH_REQUIRED=true
JWT_ISSUER=
JWT_AUDIENCE=
JWT_CLOCK_TOLERANCE_SECONDS=0
