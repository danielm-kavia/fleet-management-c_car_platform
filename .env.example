# Fleet Management service base config
HOST=0.0.0.0
PORT=3010
NODE_ENV=development
LOG_LEVEL=info

# --- Phase 9 hardening (non-breaking defaults) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX=100

SECURITY_ENABLE_CSP=false
# SECURITY_CSP=default-src 'none'; frame-ancestors 'none'; base-uri 'none'
SECURITY_ENABLE_HSTS=false
# SECURITY_HSTS=max-age=15552000; includeSubDomains

# Dev storage
# - memory: reset on restart
# - file: persists to disk
STORE_MODE=file
STORE_FILE_PATH=./data/store.json

# Auth/JWT stub settings
# If AUTH_REQUIRED=false, requests run as a dev "admin" with orgId="dev-org".
AUTH_REQUIRED=true
JWT_ISSUER=
JWT_AUDIENCE=
JWT_CLOCK_TOLERANCE_SECONDS=0
