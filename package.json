{
  "name": "fleet-management-c_car_platform",
  "version": "0.1.0",
  "private": true,
  "description": "Fleet management backend (MVP) for orgs, users, vehicles, and assignments with basic auth checks.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
