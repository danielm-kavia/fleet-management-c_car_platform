    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:integration:coverage": "jest --config jest.integration.coverage.config.js --runInBand"
  },
  "dependencies": {
    "@connected-car/shared": "file:../shared-c_car_platform",
    "express": "4.21.2"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "jest-junit": "^16.0.0"
  }
}
