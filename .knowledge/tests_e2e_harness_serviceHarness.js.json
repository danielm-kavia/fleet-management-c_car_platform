{"is_source_file": true, "format": "JavaScript", "description": "This file provides utility functions and mechanisms for managing end-to-end (E2E) testing services in a fleet management software project. It includes functions for resolving the repository root, managing service dependencies, starting/stopping services, waiting for their health status, and setting environment variables for tests. It specifically handles spawning different microservices related to vehicle state, telematics ingestion, vehicle gateway, remote commands, and fleet management, configuring their environment, ensuring dependencies are installed, and coordinating their startup and health checks.", "external_files": ["../helpers/httpClient"], "external_methods": ["httpJson"], "published": ["startServicesForE2ETests", "stopServicesForE2ETests", "buildHarnessEnv"], "classes": [], "methods": [{"name": "repoRootFromHere()", "description": "Resolves the root directory of the repository relative to this file by going four levels up from the current directory.", "scope": "", "scopeKind": ""}, {"name": "pidFilePath()", "description": "Returns the file path used to store the process IDs (PIDs) of spawned services for later management.", "scope": "", "scopeKind": ""}, {"name": "sleep(ms)", "description": "Returns a Promise that resolves after a specified number of milliseconds, used to pause execution.", "scope": "", "scopeKind": ""}, {"name": "waitForHealthy(baseUrl, timeoutMs = DEFAULT_TIMEOUT_MS)", "description": "Polls a specified service URL until it responds with a 200 status code or times out, throwing an error if the service does not become healthy within the timeout.", "scope": "", "scopeKind": ""}, {"name": "spawnService({ name, cwd, env, nodeArgs })", "description": "Spawns a new Node.js process for a service with specified environment variables and Node arguments, attaching log prefixing and exit handling.", "scope": "", "scopeKind": ""}, {"name": "ensureDirectoryExists(dirPath)", "descriptio